# Elevah — Apache (Hostinger)
Options -Indexes
DirectoryIndex index.html
DirectorySlash Off
# nunca servir planilhas ou logs
<FilesMatch "\.(csv|log)$">
Require all denied
</FilesMatch>
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
# HTTPS + domínio sem www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://elevah.tech%{REQUEST_URI} [L,R=301]
# Endereços do site anterior → páginas novas
RewriteRule ^elevah-signatuur/?$ /servicos/elevah-business-performance [L,R=301]
RewriteRule ^elevah-growth-experience/?$ /servicos/elevah-diagnostic [L,R=301]
RewriteRule ^contato/?$ /#contato [NE,L,R=301]
RewriteRule ^servicos/?$ /#solucoes [NE,L,R=301]
RewriteRule ^artigos/?$ /conteudos [L,R=301]
# URLs com index.html (ex.: /index.html, /sobre/index.html) → endereço limpo
RewriteCond %{THE_REQUEST} \s/+(.*?/)?index\.html[\s?] [NC]
RewriteRule ^ /%1 [L,R=301,NE]
RewriteRule ^artigos/(.+)$ /conteudos/$1 [L,R=301]
RewriteRule ^calculadora/?$ /calculadoras [L,R=301]
RewriteRule ^(estrategia|inicial|inicio|home|index)/?$ / [NC,L,R=301]
# Barra final opcional: /calculadoras/ → /calculadoras
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+)/$ /$1 [L,R=301]
# URLs sem barra final servem a pasta
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
<FilesMatch "\.(woff2|webp|jpg|png|svg)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(css|js)$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>
<FilesMatch "\.html$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>
AddType font/woff2 .woff2
AddType image/webp .webp
